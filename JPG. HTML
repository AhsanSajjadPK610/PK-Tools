<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>JPG to PNG - PK Tools</title>
<style>
body{margin:0;font-family:Arial;background:#f0f2f5}
.header{background:linear-gradient(135deg,#26bcff,#0041cc);color:#fff;padding:15px;text-align:center}
.box{max-width:500px;margin:30px auto;background:#fff;padding:25px;border-radius:20px;text-align:center}
button{background:linear-gradient(135deg,#26bcff,#0041cc);color:#fff;border:0;padding:14px 25px;border-radius:10px;font-weight:bold;width:95%;margin-top:10px}
a{color:#fff;text-decoration:none}
</style>
</head>
<body>
<div class="header"><a href="index.html">⬅ Back</a> | JPG to PNG 🔄</div>
<div class="box">
<h2>JPG ko PNG me Badlo</h2>
<input type="file" id="f" accept="image/*"><br><br>
<button onclick="let file=document.getElementById('f').files[0];if(!file)return alert('Image select karo');let r=new FileReader();r.onload=e=>{let a=document.createElement('a');a.href=e.target.result;a.download='PK-Tools-Converted.png';a.click()};r.readAsDataURL(file)">Convert & Download</button>
</div>
</body>
</html>
