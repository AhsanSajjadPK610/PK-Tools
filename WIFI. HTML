<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>WiFi QR - PK Tools</title>
<style>
body{margin:0;font-family:Arial;background:#f0f2f5}
.header{background:linear-gradient(135deg,#26bcff,#0041cc);color:#fff;padding:15px;text-align:center}
.box{max-width:500px;margin:30px auto;background:#fff;padding:25px;border-radius:20px;text-align:center}
.box input{width:90%;padding:14px;border-radius:10px;border:2px solid #e1e8ff;margin:6px 0}
button{background:linear-gradient(135deg,#26bcff,#0041cc);color:#fff;border:0;padding:14px 25px;border-radius:10px;font-weight:bold;width:95%;margin-top:10px}
a{color:#fff;text-decoration:none}
#qr img{border:10px solid #fff;box-shadow:0 5px 15px rgba(0,0,0,.1);border-radius:10px}
</style>
</head>
<body>
<div class="header"><a href="index.html">⬅ Back</a> | WiFi QR 📶</div>
<div class="box">
<h2>WiFi ka QR Banao</h2>
<input id="n" placeholder="WiFi Name (SSID)">
<input id="p" placeholder="WiFi Password">
<button onclick="let a=document.getElementById('n').value,b=document.getElementById('p').value;if(!a)return alert('WiFi Name likho');document.getElementById('qr').innerHTML=`<img src='https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=WIFI:T:WPA;S:${a};P:${b};;'>`">QR Banao</button>
<div id="qr" style="margin-top:20px"></div>
</div>
</body>
</html>
