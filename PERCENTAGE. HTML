<!DOCTYPE html><html><head><meta name="viewport" content="width=device-width, initial-scale=1"><title>Percentage - PK Tools</title><style>body{margin:0;font-family:Arial;background:#f0f2f5}.header{background:linear-gradient(135deg,#26bcff,#0041cc);color:#fff;padding:15px;text-align:center}.box{max-width:500px;margin:30px auto;background:#fff;padding:25px;border-radius:20px;text-align:center}.box input{width:90%;padding:14px;border-radius:10px;border:2px solid #e1e8ff;margin:5px 0}button{background:linear-gradient(135deg,#26bcff,#0041cc);color:#fff;border:0;padding:14px 25px;border-radius:10px;font-weight:bold;width:95%}a{color:#fff;text-decoration:none}</style></head><body><div class="header"><a href="index.html">⬅ Back</a> | Percentage 📊</div><div class="box"><input id="o" type="number" placeholder="Obtained Marks"><input id="t" type="number" placeholder="Total Marks"><button onclick="let a=document.getElementById('o').value,b=document.getElementById('t').value;document.getElementById('res').innerText=(a/b*100).toFixed(2)+'%'">% Nikalo</button><h2 id="res"></h2></div></body></html>
