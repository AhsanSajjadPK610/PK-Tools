<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Chat with Lisa - PK Tools</title>
<style>
body{margin:0;font-family:Arial;background:#f0f2f5;display:flex;flex-direction:column;height:100vh}
.header{background:linear-gradient(135deg,#ff3e9d,#7b2cff);color:#fff;padding:15px;text-align:center}
.header a{color:#fff;text-decoration:none}
#chat{flex:1;overflow-y:auto;padding:15px;max-width:600px;margin:0 auto;width:90%}
.msg{padding:12px 16px;border-radius:18px;margin:8px 0;max-width:80%;word-wrap:break-word}
.user{background:linear-gradient(135deg,#26bcff,#0041cc);color:#fff;margin-left:auto;border-bottom-right-radius:5px}
.bot{background:#fff;color:#333;border-bottom-left-radius:5px;box-shadow:0 2px 5px rgba(0,0,0,.05)}
.input-area{display:flex;gap:10px;padding:15px;background:#fff;max-width:600px;margin:0 auto;width:90%;box-sizing:border-box;border-radius:20px 20px 0 0}
.input-area input{flex:1;padding:14px;border-radius:25px;border:2px solid #e1e8ff;outline:none}
.input-area button{background:linear-gradient(135deg,#ff3e9d,#7b2cff);color:#fff;border:0;padding:14px 22px;border-radius:25px;font-weight:bold}
</style>
</head>
<body>
<div class="header"><a href="index.html">⬅ Back</a> | Lisa - AI Friend 💜</div>
<div id="chat"><div class="msg bot">Hi Ahsan! 😊 Main Lisa hun, tumhari AI friend. Bolo kya help chahiye?</div></div>
<div class="input-area">
<input id="inp" placeholder="Message likho..." onkeypress="if(event.key==='Enter')send()">
<button onclick="send()">Send</button>
</div>
<script>
function send(){
let i=document.getElementById('inp');
let t=i.value.trim();
if(!t)return;
let c=document.getElementById('chat');
c.innerHTML+=`<div class='msg user'>${t}</div>`;
i.value='';
setTimeout(()=>{
let r="";
if(t.toLowerCase().includes('hi')||t.toLowerCase().includes('salam')) r="Walaikum Salam! 😊 Kaise ho?";
else if(t.toLowerCase().includes('tum kon')) r="Main Lisa hun, Ahsan ne mujhe PK Tools ke liye banaya hai! 💜";
else if(t.toLowerCase().includes('tool')) r="PK Tools pe 9 tools hain - QR, Image to PDF, Stylish Name waghera. Konsa use karna hai?";
else r="Samajh gayi! 😊 Batao is bare me aur kya help karun?";
c.innerHTML+=`<div class='msg bot'>${r}</div>`;
c.scrollTop=c.scrollHeight;
},500);
c.scrollTop=c.scrollHeight;
}
</script>
</body>
</html>
